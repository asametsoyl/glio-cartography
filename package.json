{
  "name": "glio-cartography",
  "version": "3.1.1",
  "description": "Glio-Cartography — Spatial Tumor Microenvironment Atlas for Glioblastoma",
  "main": "electron/main.js",
  "author": "Glio-Cartography Team",
  "license": "PROPRIETARY",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-store": "^8.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "asar": false,
    "appId": "com.gliocartography.desktop",
    "productName": "Glio-Cartography",
    "copyright": "Copyright © 2026 Glio-Cartography Team",
    "mac": {
      "category": "public.app-category.medical",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "publisherName": "Glio-Cartography Team",
      "requestedExecutionLevel": "requireAdministrator",
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "language": "1055",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glio-Cartography",
      "uninstallDisplayName": "Glio-Cartography v3.1.1",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "python_backend/**/*"
    ],
    "extraResources": [
      {
        "from": "../configs",
        "to": "configs"
      },
      {
        "from": "python_env",
        "to": "python_env"
      }
    ]
  }
}
