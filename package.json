{
  "name": "glio-cartography",
  "version": "3.2.14",
  "description": "Glio-Cartography — Spatial Tumor Microenvironment Atlas for Glioblastoma",
  "main": "electron/main.js",
  "author": "Glio-Cartography Team",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-store": "^8.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "asar": false,
    "appId": "com.gliocartography.desktop",
    "productName": "Glio-Cartography",
    "copyright": "Copyright © 2026 Glio-Cartography Team",
    "mac": {
      "category": "public.app-category.medical",
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Glio-Cartography-mac.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "signtoolOptions": {
        "publisherName": "Glio-Cartography Team"
      },
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "artifactName": "Glio-Cartography-Setup-win.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "language": "1055",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glio-Cartography",
      "uninstallDisplayName": "Glio-Cartography v3.2.12",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Science;Medical;",
      "artifactName": "Glio-Cartography-linux.${ext}",
      "target": [
        "AppImage"
      ]
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "python_backend/**/*"
    ],
    "extraResources": [
      {
        "from": "configs",
        "to": "configs"
      },
      {
        "from": "python_env",
        "to": "python_env"
      }
    ]
  }
}
